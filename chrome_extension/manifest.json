{
  "manifest_version": 3,
  "name": "PolyEdge ALPHA — Alto Rendimiento (+EV & Rebotes Polymarket + BC)",
  "version": "1.7.0",
  "description": "Auto-selecciona compras y ventas rápidas (Take-Profit en Rebotes) en Polymarket y cuotas infladas (+EV) en BC.GAME.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://playbc.fun/*",
        "https://*.playbc.fun/*",
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*"
      ],
      "js": ["polymarket.js"],
      "run_at": "document_start"
    }
  ]
}
