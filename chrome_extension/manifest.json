{
  "manifest_version": 3,
  "name": "PolyEdge ALPHA — FULL AUTOMATIC MASTER (Polymarket & BC)",
  "version": "1.9.0",
  "description": "2 Ambientes: Full Automatic Master Polymarket + Cazador BC eBasketball Even/Odd (Par/Impar) con escudo de cuotas.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://playbc.fun/*",
        "https://*.playbc.fun/*",
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*"
      ],
      "js": [
        "polymarket.js"
      ],
      "run_at": "document_start"
    }
  ]
}