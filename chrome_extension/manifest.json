{
  "manifest_version": 3,
  "name": "PolyEdge ALPHA v2.0 — FULL AUTOMATIC MASTER (Confirmación Real)",
  "version": "2.0.0",
  "description": "Puente directo sin bloqueo de popups + Confirmación Real de compra/venta en Polymarket + Lector de Cartera + BC eBasket Even/Odd.",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://polyedge-ai.onrender.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://playbc.fun/*",
        "https://*.playbc.fun/*",
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*"
      ],
      "js": ["polymarket.js"],
      "run_at": "document_start"
    }
  ]
}
