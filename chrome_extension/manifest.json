{
  "manifest_version": 3,
  "name": "PolyEdge ALPHA — FULL AUTOMATIC MASTER (Polymarket & BC)",
  "version": "1.8.0",
  "description": "Modo Full Automatic Master en Polymarket (ciclo de N jugadas con auto-compra, auto-rebote y pausa automática para revisión) + Auto-Selector.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://playbc.fun/*",
        "https://*.playbc.fun/*",
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*"
      ],
      "js": ["polymarket.js"],
      "run_at": "document_start"
    }
  ]
}
