{
  "manifest_version": 3,
  "name": "PolyEdge AI — Auto-Selector Polymarket & PlayBC (BC.GAME)",
  "version": "1.5.0",
  "description": "Selecciona y verifica automáticamente la línea exacta Over/Under en Polymarket (dejando listo el monto para dar Buy) y en PlayBC.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://playbc.fun/*",
        "https://*.playbc.fun/*",
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*"
      ],
      "js": ["polymarket.js"],
      "run_at": "document_start"
    }
  ]
}
