{
  "manifest_version": 3,
  "name": "PolyEdge PRO — Arbitraje & +EV Cruzado (Polymarket + BC.GAME)",
  "version": "1.6.2",
  "description": "Selecciona con clic único limpio (sin doble-toggle) líneas de Arbitraje y +EV tanto en Polymarket como en BC.GAME.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://playbc.fun/*",
        "https://*.playbc.fun/*",
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*"
      ],
      "js": ["polymarket.js"],
      "run_at": "document_start"
    }
  ]
}
